{
  "name": "app-store-screenshot-generator",
  "description": "A high-performance, browser-based App Store screenshot generator with bulk export and device-accurate scaling.",
  "author": "Andreas Link",
  "license": "MIT",
  "homepage": "https://LinkAndreas.github.io/AppStore-Screenshot-Generator/",
  "private": false,
  "version": "1.5.0",
  "type": "module",
  "keywords": [
    "app-store",
    "screenshots",
    "generator",
    "ios",
    "marketing",
    "react",
    "vite",
    "high-resolution"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "file-saver": "^2.0.5",
    "html-to-image": "^1.11.13",
    "jszip": "^3.10.1",
    "lucide-react": "^1.7.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^3.5.0",
    "gh-pages": "^6.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1"
  }
}